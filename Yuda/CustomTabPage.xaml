<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabs="http://sharpnado.com"
             x:Class="yuda.CustomTabPage"
             BackgroundColor="#F2F2F2">
    <AbsoluteLayout>
       
         <ContentPresenter x:Name="TabContent" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All"/>
        <tabs:TabHostView
            x:Name="tabView"
               AbsoluteLayout.LayoutBounds="0, 1, 1, 90"
                AbsoluteLayout.LayoutFlags="WidthProportional, PositionProportional"
                  WidthRequest="330"
                    HeightRequest="60"
                    Margin="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    CornerRadius="30"
                    IsSegmented="True"
           SegmentedOutlineColor="Transparent"
                  BackgroundColor="#1C2129"
                    TabType="Fixed"
                   >
            <tabs:TabHostView.Tabs>
                <tabs:MaterialUnderlinedTabItem
                    UnselectedLabelColor="White"
                      SelectedTabColor="#80F17E"
                       UnderlineHeight="0"
                 IconImageSource="home"
                    IconOptions="IconOnly"
                                        IconSize="24"
                                        IconTextSpacing="0"
                                        Label="FILMO"
                  >
                    <!--<tabs:BottomTabItem.Badge>
                        <tabs:BadgeView BackgroundColor="White"
                               
                                TextColor="DodgerBlue"
                                Text="999+" />
                    </tabs:BottomTabItem.Badge>-->
                </tabs:MaterialUnderlinedTabItem>
                <tabs:MaterialUnderlinedTabItem
                      UnselectedLabelColor="White"
                      SelectedTabColor="#80F17E"
                   
                       UnderlineHeight="0"
                    IconImageSource="map"
                    IconOptions="IconOnly"
                                        IconSize="24"
                                        IconTextSpacing="0"
                                        Label="FILMO">
                    <!--<tabs:BottomTabItem.Badge>
                        <tabs:BadgeView BackgroundColor="DodgerBlue"
                                BadgePadding="4,2"
                                TextSize="13"
                                Text="aaaasd" />
                    </tabs:BottomTabItem.Badge>-->
                </tabs:MaterialUnderlinedTabItem>
                <tabs:MaterialUnderlinedTabItem
              UnselectedLabelColor="White"
                      SelectedTabColor="#80F17E"
                    UnderlineHeight="0"
                    IconImageSource="bulb"
                    IconOptions="IconOnly"
                                        IconSize="34"
                                        IconTextSpacing="0"
                                        Label="FILMO" >
                    <!--<tabs:BottomTabItem.Badge>
                        <tabs:BadgeView Margin="20,5"
                                BackgroundColor="Red"
                                ShowIndicator="True"
                                TextSize="14"
                                Text="3" />
                    </tabs:BottomTabItem.Badge>-->
                </tabs:MaterialUnderlinedTabItem>
            </tabs:TabHostView.Tabs>
        </tabs:TabHostView>
    </AbsoluteLayout>
</ContentPage>

