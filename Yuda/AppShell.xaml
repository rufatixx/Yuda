<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="yuda.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:yuda"
    Shell.FlyoutBehavior="Disabled"
    xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui">



  
    <Shell.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light=#f8f8f8, Dark=#121212}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </Shell.Behaviors>


   <ShellContent
       x:Name="shellContent"
        Title="Home"
        ContentTemplate="{DataTemplate local:CustomTabPage}"
        Route="MainPage" />
