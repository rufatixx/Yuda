<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yuda.Views.Registration.RegistrationFirstStep"
             Title="Registration">

    <StackLayout Margin="20">
        <Label Text="Create an Account" FontSize="Large" FontAttributes="Bold" Margin="0,20,0,0" />

        <Frame BackgroundColor="#FFFFFF" CornerRadius="10" HasShadow="True" Margin="0,20,0,0">
            <Entry Placeholder="Email" Keyboard="Email" Margin="10" />
        </Frame>

        <Frame BackgroundColor="#FFFFFF" CornerRadius="10" HasShadow="True" Margin="0,10,0,0">
            <Entry Placeholder="Password" IsPassword="True" Margin="10" />
        </Frame>

        <Frame BackgroundColor="#FFFFFF" CornerRadius="10" HasShadow="True" Margin="0,10,0,0">
            <Entry Placeholder="Confirm Password" IsPassword="True" Margin="10" />
        </Frame>

        <Button Text="Register" Margin="0,20,0,0" />

        <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand" Margin="0,30,0,0">
            <Label Text="Already have an account?" />
            <Button Text="Log in" />
        </StackLayout>
    </StackLayout>

</ContentPage>
