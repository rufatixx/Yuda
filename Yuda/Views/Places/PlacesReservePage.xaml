<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yuda.Views.Places.PlacesReservePage"
             Title="Reserve a Visit">

    <StackLayout Margin="20">
        <DatePicker x:Name="datePicker" MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}" Margin="0,10,0,0" />
        <TimePicker x:Name="timePicker" Margin="0,10,0,0" />

        <Button Text="Reserve" Margin="0,20,0,0" Clicked="OnReserveClicked" />
    </StackLayout>

</ContentPage>
