<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yuda.Views.Places.PlacesDetailsPage"
             Title="{Binding Name}">

    <StackLayout Margin="20">
        <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold" Margin="0,10,0,0" />
        <Label Text="{Binding Address}" FontSize="Small" />

        <Button Text="Reserve a Visit" Clicked="OnReserveClicked" />

        <StackLayout Margin="0,20,0,0">
            <Label Text="Description" FontSize="Medium" FontAttributes="Bold" />
            <Label Text="{Binding Description}" FontSize="Small" />
        </StackLayout>

        <StackLayout Margin="0,20,0,0">
            <Label Text="Business Hours" FontSize="Medium" FontAttributes="Bold" />
            <Label Text="{Binding BusinessHours}" FontSize="Small" />
        </StackLayout>
    </StackLayout>

</ContentPage>
